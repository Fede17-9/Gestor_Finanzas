# Copy to .env.local and configure a Supabase test project.
# Public browser credentials only. Never use a secret or service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
# Preferred for new setups. The legacy variable below remains supported.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Only needed if your existing configuration uses the legacy public key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
